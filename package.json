{
  "name": "avenx-vscode-support",
  "displayName": "Avenx-JS Support",
  "description": "Syntax highlighting, snippets and basic support for Avenx-JS (.axt, .axd, .avx).",
  "version": "0.0.1",
  "publisher": "avenx",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:avenxExplorer"
  ],
  "contributes": {
    "languages": [
      {
        "id": "axt",
        "aliases": [
          "Avenx Template",
          "axt"
        ],
        "extensions": [
          ".axt"
        ],
        "configuration": "./language-configuration-axt.json"
      },
      {
        "id": "axd",
        "aliases": [
          "Avenx Definition",
          "axd"
        ],
        "extensions": [
          ".axd"
        ],
        "configuration": "./language-configuration-axd.json"
      },
      {
        "id": "javascript",
        "extensions": [
          ".avx"
        ]
      }
    ],
    "grammars": [
      {
        "language": "axt",
        "scopeName": "text.html.axt",
        "path": "./syntaxes/axt.tmLanguage.json",
        "embeddedLanguages": {
          "source.js": "javascript"
        }
      },
      {
        "language": "axd",
        "scopeName": "source.css.axd",
        "path": "./syntaxes/axd.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "axt",
        "path": "./snippets/axt.code-snippets"
      },
      {
        "language": "axd",
        "path": "./snippets/axd.code-snippets"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "avenx-sidebar",
          "title": "Avenx",
          "icon": "media/logo.svg"
        }
      ]
    },
    "views": {
      "avenx-sidebar": [
        {
          "type": "webview",
          "id": "avenxExplorer",
          "name": "Avenx Overview"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.75.0",
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "16.x",
    "@typescript-eslint/eslint-plugin": "^5.53.0",
    "@typescript-eslint/parser": "^5.53.0",
    "eslint": "^8.34.0",
    "glob": "^8.1.0",
    "mocha": "^10.2.0",
    "typescript": "^4.9.5",
    "@vscode/test-electron": "^2.2.3"
  }
}
