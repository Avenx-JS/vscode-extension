{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Avenx Definition",
  "scopeName": "source.css.axd",
  "patterns": [
    { "include": "#scopes" },
    { "include": "#variable_definition" },
    { "include": "#variable_usage" },
    { "include": "#nesting" },
    { "include": "source.css" }
  ],
  "repository": {
    "scopes": {
      "match": "(<\\s*/?\\s*)(@global|@css)(\\s*>)",
      "captures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "keyword.control.avenx" },
        "3": { "name": "punctuation.definition.tag.end.html" }
      }
    },
    "variable_definition": {
      "match": "(@def)\\s+([a-zA-Z0-9_-]+)\\s+([^;]+);",
      "captures": {
        "1": { "name": "keyword.control.def.avenx" },
        "2": { "name": "variable.parameter.avenx" },
        "3": { "name": "constant.other.color.avenx" }
      }
    },
    "variable_usage": {
      "match": "(@)([a-zA-Z0-9_-]+)",
      "captures": {
        "1": { "name": "punctuation.definition.variable.avenx" },
        "2": { "name": "variable.other.avenx" }
      }
    },
    "nesting": {
      "match": "&",
      "name": "keyword.operator.nesting.avenx"
    }
  }
}
