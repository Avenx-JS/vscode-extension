{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Avenx Template",
  "scopeName": "text.html.axt",
  "patterns": [
    { "include": "#interpolation" },
    { "include": "#state_tag" },
    { "include": "#action_tag" },
    { "include": "#css_marker" },
    { "include": "#event_attributes" },
    { "include": "text.html.basic" }
  ],
  "repository": {
    "interpolation": {
      "begin": "\\{\\{",
      "beginCaptures": {
        "0": { "name": "punctuation.section.embedded.begin.avenx" }
      },
      "end": "\\}\\}",
      "endCaptures": {
        "0": { "name": "punctuation.section.embedded.end.avenx" }
      },
      "contentName": "source.js",
      "patterns": [
        { "include": "source.js" }
      ]
    },
    "state_tag": {
      "begin": "(<)(state)\\b",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "storage.type.avenx" }
      },
      "end": "(/?>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.end.html" }
      },
      "patterns": [
        { "include": "text.html.basic#tag-stuff" }
      ]
    },
    "action_tag": {
      "begin": "(<)(action)\\b",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "keyword.control.avenx" }
      },
      "end": "(</)(action)(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "keyword.control.avenx" },
        "3": { "name": "punctuation.definition.tag.end.html" }
      },
      "patterns": [
        {
          "begin": "(>)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.end.html" }
          },
          "end": "(?=</action)",
          "contentName": "source.js",
          "patterns": [
            { "include": "source.js" }
          ]
        },
        { "include": "text.html.basic#tag-stuff" }
      ]
    },
    "css_marker": {
      "match": "(<)(@css)\\s+([a-zA-Z0-9_-]+)?\\s*(/?>)",
      "captures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "keyword.control.css.avenx" },
        "3": { "name": "entity.other.attribute-name.class.css" },
        "4": { "name": "punctuation.definition.tag.end.html" }
      }
    },
    "event_attributes": {
      "begin": "(@[a-zA-Z0-9_-]+)(=)(\")",
      "beginCaptures": {
        "1": { "name": "entity.other.attribute-name.event.avenx" },
        "2": { "name": "punctuation.separator.key-value.html" },
        "3": { "name": "punctuation.definition.string.begin.html" }
      },
      "end": "(\")",
      "endCaptures": {
        "1": { "name": "punctuation.definition.string.end.html" }
      },
      "contentName": "source.js",
      "patterns": [
        { "include": "source.js" }
      ]
    }
  }
}
